{
  // Despliegue de NEXUS PRO en Cloudflare (sitio estático = "assets").
  // No hay build: se sirve el repositorio tal cual (index.html, parches.js, sw.js, etc.).
  //
  // worker.js solo se ejecuta para /boleto.html (run_worker_first) y arma la
  // vista previa (Open Graph) del boleto con banner + número para WhatsApp.
  // Todo lo demás se sirve estático sin tocar al Worker.
  // 25-oct-2026: run_worker_first pasa de true a ["/boleto.html"]. Con true el Worker
  // corría en TODAS las peticiones y Cloudflare no aplicaba el archivo _headers (caché).
  // "/" también pasa por el Worker solo para ponerle la huella ETag (conHuella en worker.js).
  "name": "nexus-pro",
  "compatibility_date": "2025-06-01",
  "main": "worker.js",
  // Fecha de cada publicación para el Last-Modified de la página principal (worker.js → conHuella).
  "version_metadata": { "binding": "CF_VERSION" },
  "assets": {
    "directory": "./",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/boleto.html"]
  }
}
